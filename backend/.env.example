PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_secret
CLIENT_URL=http://localhost:5173

# Contact form email
CONTACT_TO_EMAIL=support@uithings.site

# SMTP (cPanel email account)
SMTP_HOST=mail.uithings.site
SMTP_PORT=465
SMTP_USER=support@uithings.site
SMTP_PASS=your_email_account_password
SMTP_FROM_EMAIL=support@uithings.site
SMTP_FROM_NAME=UI Things

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=figma-components

# Upstash Redis (free tier at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Cache TTLs in seconds (optional – defaults shown)
CACHE_TTL_LIST=60
CACHE_TTL_SINGLE=300
CACHE_TTL_MY=30

# Razorpay Payment Integration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
