PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_secret
CLIENT_URL=http://localhost:5173

# Contact form email
CONTACT_TO_EMAIL=support@uithings.site

# Mail provider
MAIL_PROVIDER=resend

# Resend (free: 3,000 emails/month, 100/day)
# 1. Create an API key at https://resend.com/api-keys ("Sending access" is enough)
# 2. Add and verify the domain in Resend, then copy the DNS records it shows
# 3. Use a From address on that verified domain
# See mailguide.md at the repo root for the full setup
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=no-reply@uithings.site
RESEND_FROM_NAME=UI Things

# Email OTP verification (for local registration)
OTP_SECRET=replace_with_long_secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=figma-components

# Upstash Redis (free tier at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Cache TTLs in seconds (optional – defaults shown)
CACHE_TTL_LIST=60
CACHE_TTL_SINGLE=300
CACHE_TTL_MY=30

# Razorpay Payment Integration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
